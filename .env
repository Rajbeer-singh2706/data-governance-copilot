# Create .env in the root folder :

ENABLE_MOCK=true
LOG_LEVEL=INFO
DEBUG=false
LOG_FILE=./logs/copilot.log
MAX_RETRIES=3
TIMEOUT_SECONDS=60


## Leave these blank for now - we'wll fill them later
OPEN_API_KEY=
DATABRICKS_HOST=
JIRA_BASE_URL=

# Add to .env:
LANGCHAIN_TRACING_V2=true
