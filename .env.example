# ── Core ────────────────────────────────────────────────────────────────────
#OPENAI_API_KEY=sk-...
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
ENABLE_MOCK=false
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=development

# ── LangSmith ───────────────────────────────────────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=data-governance-copilot

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="gitcopilot"


# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# ── LiteLLM fallbacks ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Neon PostgreSQL (primary) ─────────────────────────────────────────────
# Paste the "Connection string" from your Neon project dashboard.
# Use the pooled URL (port 5432 via pgBouncer) for app services.
# Use the direct URL (port 5432 on the host EP) for Airflow metadata.
#
DATABASE_URL=
#
# If you need separate Airflow metadata DB (recommended for Neon):
AIRFLOW_DB_URL=
#
# SSL mode — always "require" for Neon
POSTGRES_SSLMODE=require

# ── Vector / Ingestion ────────────────────────────────────────────────────
VECTOR_COLLECTION=governance_docs
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=64
INGESTION_EMBEDDING_MODEL=text-embedding-3-small
INGESTION_BATCH_SIZE=100

# ── MCP Server ────────────────────────────────────────────────────────────
# Transport: "stdio" for Claude Desktop, "sse" for remote/web clients
TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8002
# Enable MCP routing inside the main app
USE_MCP=false
COLLIBRA_MCP_SERVER=
JIRA_MCP_SERVER=

# ── Airflow ─────────────────────────────────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=changeme
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_DOCS_PATH=./docs

# ── Teams Bot ────────────────────────────────────────────────────────────────
TEAMS_APP_SECRET=

# ── Databricks ───────────────────────────────────────────────────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=