# ── Core ──────────────────────────────────────────────────────────────────
ENABLE_MOCK=true          # true = no real API calls needed (dev / CI)
ENVIRONMENT=development   # development | production
DEBUG=false
LOG_LEVEL=INFO

# ── LLM Provider — choose ONE ─────────────────────────────────────────────

# Option A: Groq (recommended for dev — fast, free tier, no credit card)
#   Sign up at https://console.groq.com → API Keys
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...

# Option B: OpenAI (switch LLM_PROVIDER=openai and set below)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# ── LangSmith tracing (optional — Day 13) ─────────────────────────────────
# Sign up free at https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=data-governance-copilot

# ── Redis (Day 14) ────────────────────────────────────────────────────────
# Running locally?  docker run -p 6379:6379 redis:7.2-alpine
# Not running Redis? Set REDIS_ENABLED=false — app falls back to in-memory cache
REDIS_ENABLED=true
REDIS_HOST=localhost       # use "redis" when running inside docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=            # leave blank for local dev

# ── Memory ────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/memory.db

# ── Databricks (leave blank in dev — mock mode handles it) ────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=

# ── Jira (leave blank in dev) ─────────────────────────────────────────────
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=

# ── LiteLLM fallbacks (only needed if LLM_PROVIDER=openai) ───────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
