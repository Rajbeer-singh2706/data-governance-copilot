# ── Core ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | production
DEBUG=false
LOG_LEVEL=INFO

# ── LLM Provider ──────────────────────────────────────────────────────────
# Groq (recommended — fast, free tier)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=gsk_...

# LiteLLM fallback providers (optional)
OPENAI_API_KEY=sk-...     # also required for pgvector embeddings (KnowledgeAgent)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── LangSmith tracing (optional) ─────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=data-governance-copilot

# ── Redis ─────────────────────────────────────────────────────────────────
# docker run -p 6379:6379 redis:7.2-alpine
# Set REDIS_ENABLED=false to use in-memory fallback instead
REDIS_ENABLED=true
REDIS_HOST=localhost       # use "redis" inside docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Memory ────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/memory.db

# ── Databricks (required for InformationAgent + RuleAgent evaluation) ─────
# Sign up at https://databricks.com → Settings → Developer → Access Tokens
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<id>

# ── PostgreSQL + pgvector (required for KnowledgeAgent) ──────────────────
# docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 pgvector/pgvector:pg16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=governance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Collibra (required for MetadataAgent) ────────────────────────────────
COLLIBRA_BASE_URL=https://<tenant>.collibra.com
COLLIBRA_API_TOKEN=

# ── Jira (required for CapacityAgent) ────────────────────────────────────
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://<org>.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DATA

# ── Teams Bot ─────────────────────────────────────────────────────────────
TEAMS_APP_SECRET=          # blank = HMAC disabled in dev

# ── MCP (optional — USE_MCP=false uses direct REST for Collibra/Jira) ─────
USE_MCP=false
COLLIBRA_MCP_SERVER=       # path/command to Collibra MCP server binary
JIRA_MCP_SERVER=           # path/command to Jira MCP server binary

# ── FastAPI ───────────────────────────────────────────────────────────────
CORS_ORIGINS=*
MAX_WORKERS=4
