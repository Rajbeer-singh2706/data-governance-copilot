# Create .env in the root folder :

# ENABLE_MOCK=true
# LOG_LEVEL=INFO
# DEBUG=false
# LOG_FILE=./logs/copilot.log
# MAX_RETRIES=3
# TIMEOUT_SECONDS=60


# ## Leave these blank for now - we'wll fill them later
# OPEN_API_KEY=
# DATABRICKS_HOST=
# JIRA_BASE_URL=

# # Add to .env:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-...        # from smith.langchain.com
# LANGCHAIN_PROJECT=data-governance-copilot
# SQLITE_PATH=./data/memory.db
# ENVIRONMENT=development


# ── Core ──────────────────────────────────────────────────────────────────
ENABLE_MOCK=true          # true = no real API calls needed (dev / CI)
ENVIRONMENT=development   # development | production
DEBUG=false
LOG_LEVEL=INFO

# ── LLM ───────────────────────────────────────────────────────────────────
# IMPORTANT: key name is OPENAI_API_KEY (not OPEN_API_KEY — fix in your .env)
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o          # gpt-4o-mini works for intent only (faster + cheaper)

# ── LangSmith tracing (Day 13) ────────────────────────────────────────────
# Sign up free at https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=data-governance-copilot

# ── Memory ────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/memory.db

# ── Databricks (leave blank in dev — mock mode handles it) ────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=

# ── Jira (leave blank in dev) ─────────────────────────────────────────────
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=

# ── Timeouts ──────────────────────────────────────────────────────────────
MAX_RETRIES=3
TIMEOUT_SECONDS=60
LOG_FILE=./logs/copilot.log
