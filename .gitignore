# .gitignore
.env                  # secrets — NEVER commit this
venv/                 # virtual environment
__pycache__/          # Python bytecode cache
*.pyc                 # compiled Python files
*.egg-info/           # build artifacts
.eggs/
dist/
build/
logs/*.log            # log files
data/vectorstore/     # FAISS index (large binary files)
.pytest_cache/